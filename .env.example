# Supabase — obrigatório
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# APP_URL
APP_URL="MY_APP_URL"

# --- Nenhuma chave de API de IA deve ficar aqui ---
# Todas as chaves ficam exclusivamente como secrets na Edge Function:
#   npx supabase secrets set GEMINI_API_KEY_1=... GEMINI_API_KEY_2=... OPENAI_API_KEY=... --project-ref <ref>
# O bundle JS não contém nenhuma chave.
